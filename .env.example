# Optional: only required for local Prisma migration or studio commands.
# The deployed app reads and writes through authenticated Supabase APIs.
DATABASE_URL="postgresql://user:password@host:5432/curated_by_carly?sslmode=require"

# Supabase Project URL and publishable key. The publishable key is safe for the browser;
# authorization still depends on server checks and Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Private bucket used for wardrobe, archive, and Personal Shopper images.
SUPABASE_PRIVATE_MEDIA_BUCKET="curated-private-media"

# Server-only OpenAI key for garment analysis and styling conversations.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"

# Server-only Google Places key for venue and street-address autocomplete.
GOOGLE_PLACES_API_KEY=""

# Server-only Google Calendar OAuth. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/calendar/callback/google"
# Generate 32 random bytes and base64 encode them. Retain old versions during rotation.
CALENDAR_TOKEN_ENCRYPTION_KEY_V1=""
CALENDAR_TOKEN_ENCRYPTION_ACTIVE_VERSION="1"
CALENDAR_IDENTIFIER_HMAC_KEY=""

# Optional development-only owner when Supabase Auth is intentionally disabled.
# This fallback is rejected in production.
CURATED_DEMO_USER_ID="00000000-0000-0000-0000-000000000000"
# Preview-only governed event policies. Keep false in Production until Product
# approves the candidate audit and plain-text recommendations.
DRESS_MY_DAY_EVENT_POLICY_V1=false
FOUNDER_DIAGNOSTICS_ENABLED=false
# Comma-separated emails permitted to open the unlinked, server-protected diagnostics study.
FOUNDER_DIAGNOSTICS_EMAILS=

# Founder-only V2 Evaluation remains disabled until Product explicitly
# authorizes activation. It is never valid on Production or an unlisted host.
RECOMMENDATION_V2_EVALUATION_ENABLED=false
RECOMMENDATION_V2_EVALUATION_EMAILS=
RECOMMENDATION_V2_EVALUATION_HOSTS=

# Main-application V2 routing is server-only and fails closed. Assignment uses
# immutable Supabase user IDs, never email or a browser-provided mode. Keep the
# global kill switch true until every activation gate has passed.
RECOMMENDATION_V2_MAIN_APP_CODE_ENABLED=false
RECOMMENDATION_V2_FOUNDER_ACTIVATION_AUTHORIZED=false
RECOMMENDATION_V2_GLOBAL_KILL_SWITCH=true
RECOMMENDATION_V2_ASSIGNED_USER_IDS=
RECOMMENDATION_V2_KILLED_USER_IDS=
RECOMMENDATION_V2_FEATURE_FLAG_REVISION=disabled
